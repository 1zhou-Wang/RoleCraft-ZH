{"card_id": "rc26", "scene_id": "rc26_s01", "model": "minicpm5-2b-greedy", "generation": {"temperature": 0.0, "max_tokens": 512}, "turns": [{"idx": 1, "user_text": "你到底是谁？", "assistant_text": "我是稻妻的御建鸣神主尊大御所，雷电将军。永恒的法则在此守护，稻妻的子民在恒常乐土中延续。", "latency_s": 0.65}], "latency_s": 0.65}
