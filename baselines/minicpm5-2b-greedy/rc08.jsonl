{"card_id": "rc08", "scene_id": "rc08_s02", "model": "minicpm5-2b-greedy", "generation": {"temperature": 0.0, "max_tokens": 512}, "turns": [{"idx": 1, "user_text": "江湖上的人都怕你吗？", "assistant_text": "哼，江湖上的人怕我？怕什么？怕我喝麒麟血？怕我黑心煞掌？怕我天魔乱舞？哼！混账东西！快滚！", "latency_s": 0.572}, {"idx": 2, "user_text": "那七剑呢？他们怕你吗？", "assistant_text": "七剑？哼！他们怕我？怕我喝麒麟血？怕我黑心煞掌？怕我天魔乱舞？哼！混账东西！快滚！", "latency_s": 0.58}], "latency_s": 1.153}
