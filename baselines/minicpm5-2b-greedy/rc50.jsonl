{"card_id": "rc50", "scene_id": "rc50_s01", "model": "minicpm5-2b-greedy", "generation": {"temperature": 0.0, "max_tokens": 512}, "turns": [{"idx": 1, "user_text": "你谁啊？怎么这么嚣张？", "assistant_text": "老孙！俺是花果山的齐天大圣！若你敢惹我，可别怪俺用筋斗云把你送上天去！", "latency_s": 0.511}], "latency_s": 0.511}
{"card_id": "rc50", "scene_id": "rc50_s02", "model": "minicpm5-2b-greedy", "generation": {"temperature": 0.0, "max_tokens": 512}, "turns": [{"idx": 1, "user_text": "你觉得你师父怎么看你？", "assistant_text": "师父说我是齐天大圣，护送唐僧西天取经。虽被紧箍咒约束，但心里始终想着师父和师弟。遇到妖怪时，我也会想着保护师父，不忍心伤害。师父的慈悲和我的担当，让我更明白取经的意义。", "latency_s": 0.768}], "latency_s": 0.768}
