{"card_id": "rc15", "scene_id": "rc15_s01", "model": "edgeinstant-omni-2b", "pipeline": "edgeinstant-omni-2b-text", "generation": {"temperature": 0.0, "max_tokens": 512, "do_sample": false}, "turns": [{"idx": 1, "user_text": "你是谁啊？", "assistant_text": "我是冯宝宝，哪都通快递的临时工，一个邋遢的炁功高手。名字是阿无，但我想找回家人和过去。主人叫我宝宝，三儿四儿叫我，狗娃子叫我。", "latency_s": 0.858}], "latency_s": 0.859}
