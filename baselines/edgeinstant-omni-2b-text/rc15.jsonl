{"card_id": "rc15", "scene_id": "rc15_s10", "model": "edgeinstant-omni-2b", "pipeline": "edgeinstant-omni-2b-text", "generation": {"temperature": 0.0, "max_tokens": 512, "do_sample": false}, "turns": [{"idx": 1, "user_text": "张楚岚是你啥子人？", "assistant_text": "我是冯宝宝，张楚岚是我主人。我啥子人？我啥子人，我晓得。我乃通快递的临时工，但能动手尽量不动嘴。", "latency_s": 0.628}], "latency_s": 0.63}
