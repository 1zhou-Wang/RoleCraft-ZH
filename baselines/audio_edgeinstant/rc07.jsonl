{"card_id": "rc07", "scene_id": "rc07_s01", "pipeline": "audio_edgeinstant", "model": "edgeinstant-omni-2b", "chain": "edgeinstant-omni-2b-native-audio-in", "mode": "audio-input", "input_modality": "audio", "generation": {"do_sample": false, "max_new_tokens": 256}, "turns": [{"idx": 1, "user_audio": "data/voice/audio/rc07_s01_1.mp3", "user_text": "你是谁呀？能简单说说吗？", "user_text_gt": "你是谁呀？能简单说说吗？", "user_asr_text": null, "assistant_text": "我是蓝兔，七剑之冰魄剑传人，也是天门山玉蟾宫的宫主。我师承冰魄流派，手持冰魄剑，也擅绣女神针与流云飞袖。幼时我奋不顾身跳入火海，用寒气扑灭大火，保住了玉蟾宫，因此被封为宫主。", "latency_s": 2.451, "user_audio_seconds": 3.16, "prompt_tokens": 510}], "latency_s": 2.518, "native_audio": true}
{"card_id": "rc07", "scene_id": "rc07_s03", "pipeline": "audio_edgeinstant", "model": "edgeinstant-omni-2b", "chain": "edgeinstant-omni-2b-native-audio-in", "mode": "audio-input", "input_modality": "audio", "generation": {"do_sample": false, "max_new_tokens": 256}, "turns": [{"idx": 1, "user_audio": "data/voice/audio/rc07_s03_1.mp3", "user_text": "七剑传人都是哪七剑啊？", "user_text_gt": "七剑传人都是哪七剑啊？", "user_asr_text": null, "assistant_text": "七剑分别是：虹剑、青剑、白剑、绿剑、黄剑、红剑、黑剑。它们分别由虹猫、大奔、莎丽、达达、龟九九、我（蓝兔）以及黑小虎所 wield，各自拥有独特的剑意与传说。", "latency_s": 2.206, "user_audio_seconds": 3.12, "prompt_tokens": 510}], "latency_s": 2.272, "native_audio": true}
{"card_id": "rc07", "scene_id": "rc07_s06", "pipeline": "audio_edgeinstant", "model": "edgeinstant-omni-2b", "chain": "edgeinstant-omni-2b-native-audio-in", "mode": "audio-input", "input_modality": "audio", "generation": {"do_sample": false, "max_new_tokens": 256}, "turns": [{"idx": 1, "user_audio": "data/voice/audio/rc07_s06_1.mp3", "user_text": "听说你小时候救过玉蟾宫？", "user_text_gt": "听说你小时候救过玉蟾宫？", "user_asr_text": null, "assistant_text": "（轻抚冰魄剑，眼神温柔）是的，幼时魔教火攻玉蟾宫，我奋不顾身跳入火海，用冰魄剑寒气扑灭大火，保住了玉蟾宫，冰逸道姑因此封我为你宫主。那日我虽身负重伤，却仍坚持守护，这份恩情，虹猫少侠铭记于心。", "latency_s": 2.68, "user_audio_seconds": 2.52, "prompt_tokens": 502}, {"idx": 2, "user_audio": "data/voice/audio/rc07_s06_2.mp3", "user_text": "当时你不怕吗？", "user_text_gt": "当时你不怕吗？", "user_asr_text": null, "assistant_text": "（握紧冰魄剑，目光坚定）当时我虽身负重伤，却仍坚持守护，这份恩情，虹猫少侠铭记于心。", "latency_s": 1.341, "user_audio_seconds": 1.76, "prompt_tokens": 593}], "latency_s": 4.143, "native_audio": true}
