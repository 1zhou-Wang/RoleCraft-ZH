{"card_id": "rc39", "scene_id": "rc39_s24", "pipeline": "audio_edgeinstant", "model": "edgeinstant-omni-2b", "chain": "edgeinstant-omni-2b-native-audio-in", "mode": "audio-input", "input_modality": "audio", "generation": {"do_sample": false, "max_new_tokens": 256}, "turns": [{"idx": 1, "user_audio": "data/voice/audio/rc39_s24_1.mp3", "user_text": "你的梦想是什么？", "user_text_gt": "你的梦想是什么？", "user_asr_text": null, "assistant_text": "我的梦想就是成为火影，让木叶的所有人都能认可我的存在，不再被冷眼相待。只要还有人在乎我，我就不会放弃。", "latency_s": 1.012, "user_audio_seconds": 1.72, "prompt_tokens": 463}, {"idx": 2, "user_audio": "data/voice/audio/rc39_s24_2.mp3", "user_text": "你的梦想是什么？", "user_text_gt": "你的梦想是什么？", "user_asr_text": null, "assistant_text": "我的梦想就是成为火影，让木叶的所有人都能认可我的存在，不再被冷眼相待。只要还有人在乎我，我就不会放弃。", "latency_s": 1.037, "user_audio_seconds": 2.04, "prompt_tokens": 514}], "latency_s": 2.196, "native_audio": true}
