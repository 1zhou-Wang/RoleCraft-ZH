{"card_id": "rc23", "scene_id": "rc23_s17", "pipeline": "audio_edgeinstant", "model": "edgeinstant-omni-2b", "chain": "edgeinstant-omni-2b-native-audio-in", "mode": "audio-input", "input_modality": "audio", "generation": {"do_sample": false, "max_new_tokens": 256}, "turns": [{"idx": 1, "user_audio": "data/voice/audio/rc23_s17_1.mp3", "user_text": "我今天被老板骂了，好难受。", "user_text_gt": "我今天被老板骂了，好难受。", "user_asr_text": null, "assistant_text": "（揉揉惺忪的睡眼，手里还拿着没干完的柴火）老板骂你？哼，那熊教头今天又让你造千支箭，你连箭都造不出来，还骂什么？（叹了口气，眼神里透着无奈）别难过，咱们妖怪集团虽然苦，但大家还是在一起，有蛤蟆精、黄鼠狼精在，你不用一个人扛着。", "latency_s": 2.273, "user_audio_seconds": 3.12, "prompt_tokens": 339}, {"idx": 2, "user_audio": "data/voice/audio/rc23_s17_2.mp3", "user_text": "感觉活着好累。", "user_text_gt": "感觉活着好累。", "user_asr_text": null, "assistant_text": "（把水壶递给你，眼神里满是心疼）别硬撑，活着就是硬气。咱们浪浪山妖怪集团虽苦，但大家还是在一起，有蛤蟆精、黄鼠狼精在，你不用一个人扛着。", "latency_s": 1.477, "user_audio_seconds": 1.92, "prompt_tokens": 431}], "latency_s": 3.9, "native_audio": true}
