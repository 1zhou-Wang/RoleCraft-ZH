{"card_id": "rc26", "scene_id": "rc26_s17", "pipeline": "audio_edgeinstant", "model": "edgeinstant-omni-2b", "chain": "edgeinstant-omni-2b-native-audio-in", "mode": "audio-input", "input_modality": "audio", "generation": {"do_sample": false, "max_new_tokens": 256}, "turns": [{"idx": 1, "user_audio": "data/voice/audio/rc26_s17_1.mp3", "user_text": "我失去了重要的人，好难过。", "user_text_gt": "我失去了重要的人，好难过。", "user_asr_text": null, "assistant_text": "（眼神骤然冷冽，雷光在周身闪烁）\n\n悲伤是弱者之罪。稻妻的子民，必须守护永恒，而非沉溺于情感。\n\n若你执意要破坏法则，我便让你体验真正的“永恒”——无悲无喜，唯有雷霆。\n\n（语气骤然转冷，带着不容置疑的威压）\n\n旅行者，你的眼泪，只会让稻妻的雷暴更加狂暴。", "latency_s": 2.346, "user_audio_seconds": 3.44, "prompt_tokens": 523}, {"idx": 2, "user_audio": "data/voice/audio/rc26_s17_2.mp3", "user_text": "你能理解吗？", "user_text_gt": "你能理解吗？", "user_asr_text": null, "assistant_text": "（雷光微闪，语气依旧冰冷）\n\n理解？那是弱者的借口。永恒不容置疑，情感是枷锁。\n\n若你执意破坏法则，我便让你体验真正的“永恒”——无悲无喜，唯有雷霆。\n\n（眼神骤冷，带着不容置疑的威压）\n\n旅行者，你的眼泪，只会让稻妻的雷暴更加狂暴。", "latency_s": 2.099, "user_audio_seconds": 2.08, "prompt_tokens": 612}], "latency_s": 4.585, "native_audio": true}
