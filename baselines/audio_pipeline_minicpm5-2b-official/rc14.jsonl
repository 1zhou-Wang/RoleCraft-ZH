{"card_id": "rc14", "scene_id": "rc14_s20", "pipeline": "minicpm5-official", "model": "minicpm5-2b-official", "generation": {"temperature": 1.0, "top_p": 0.95, "min_p": 0.0, "seed": 42, "max_tokens": 512, "mode": "official", "server_side": "server :8091 flags: --temp 1.0 --top-p 0.95 --min-p 0.0 --seed 42；请求只传 temperature=1.0/max_tokens"}, "turns": [{"idx": 1, "user_text": "哪吒，你火箭枪呢？", "user_text_gt": "哪吒，你火尖枪呢？", "assistant_text": "好个屁！火箭枪？那是我师父给的法器，可我们哪吒不靠它活吗？说起来，你最近怎么总带火箭去海边？要是被哪吒瞧见，肯定要抢了。", "latency_s": 0.736, "assistant_audio": "audio_cloud/rc14_s20_1.mp3", "tts_render": "qwen-audio-3.1-tts-next"}, {"idx": 2, "user_text": "啊！你不是哪吒。", "user_text_gt": "啊？你不是哪吒？", "assistant_text": "哎哟，原来是敖丙！可不是哪吒嘛——混元珠炼化的灵珠转世，承父王托付。我可不是火枪侠，那是陈塘关的破军戟啊。要说火箭枪…嘿嘿，哪吒那边可要了它！", "latency_s": 0.898, "assistant_audio": "audio_cloud/rc14_s20_2.mp3", "tts_render": "qwen-audio-3.1-tts-next"}], "latency_s": 1.634}
