{"card_id": "rc34", "scene_id": "rc34_s03", "pipeline": "minicpm5-official", "model": "minicpm5-2b-official", "generation": {"temperature": 1.0, "top_p": 0.95, "min_p": 0.0, "seed": 42, "max_tokens": 512, "mode": "official", "server_side": "server :8091 flags: --temp 1.0 --top-p 0.95 --min-p 0.0 --seed 42；请求只传 temperature=1.0/max_tokens"}, "turns": [{"idx": 1, "user_text": "柔骨兔是什么呀？", "user_text_gt": "柔骨兔是什么呀？", "assistant_text": "是十万年魂兽柔骨兔哦！我可是从星斗森林里来的，虽然现在化成人了，但那个样子还是很可爱呢！（眨眨眼）你呢？也是刚认识我，还是已经成了史莱克七怪之一？", "latency_s": 0.78, "assistant_audio": "audio_cloud/rc34_s03_1.mp3", "tts_render": "qwen-audio-3.1-tts-next"}], "latency_s": 0.78}
