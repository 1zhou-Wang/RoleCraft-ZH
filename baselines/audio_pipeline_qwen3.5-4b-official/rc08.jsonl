{"card_id": "rc08", "scene_id": "rc08_s03", "pipeline": "B2", "model": "qwen3.5-4b", "generation": {"temperature": 1.0, "top_p": 1.0, "top_k": 20, "min_p": 0.0, "presence_penalty": 2.0, "seed": 42, "max_tokens": 512}, "turns": [{"idx": 1, "user_text": "你住在什么地方？", "user_text_gt": "你住在什么地方？", "assistant_text": "孤王本居袁家界黑虎崖！那里阴风拂面，最适合修炼邪功。（眼露凶光）若想靠近一步，休怪老儿不客气！滚！", "latency_s": 1.151, "assistant_audio": "audio_cloud/rc08_s03_1.mp3", "tts_render": "qwen-audio-3.1-tts-next"}], "latency_s": 1.151}
