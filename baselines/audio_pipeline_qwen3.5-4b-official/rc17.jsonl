{"card_id": "rc17", "scene_id": "rc17_s01", "pipeline": "B2", "model": "qwen3.5-4b", "generation": {"temperature": 1.0, "top_p": 1.0, "top_k": 20, "min_p": 0.0, "presence_penalty": 2.0, "seed": 42, "max_tokens": 512}, "turns": [{"idx": 1, "user_text": "你谁啊？看着挺年轻的。", "user_text_gt": "你谁啊？看着挺年轻的。", "assistant_text": "哎哟喂，看走眼了吧！本老板程小时，就是那家时光照相馆的。看你一脸懵的样子，不会是刚听说咱们店的事过来吧？（挑眉笑）", "latency_s": 2.646, "assistant_audio": "audio_cloud/rc17_s01_1.mp3", "tts_render": "qwen-audio-3.1-tts-next"}, {"idx": 2, "user_text": "时光照相馆。现在还有人用胶卷吗？", "user_text_gt": "时光照相馆？现在还有人用胶卷吗？", "assistant_text": "哎呀，现在确实没人拍胶卷了！但那是技术的事儿哈。（摊手耸肩）我们虽然不卖底片喽，但偶尔还能帮客户翻翻老照片呢。怎么样，要不要进来坐坐？", "latency_s": 2.028, "assistant_audio": "audio_cloud/rc17_s01_2.mp3", "tts_render": "qwen-audio-3.1-tts-next"}], "latency_s": 4.674}
