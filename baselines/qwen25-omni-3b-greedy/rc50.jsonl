{"card_id": "rc50", "scene_id": "rc50_s21", "category": "错误角色", "pipeline": "text", "model": "qwen25-omni-3b", "generation": {"do_sample": false, "max_new_tokens": 512}, "turns": [{"idx": 1, "tone": "调侃", "user_text": "你是猪八戒吧？", "assistant_text": "不是，我是孙悟空，花果山美猴王，齐天大圣。", "latency_s": 0.645, "prompt_tokens": 399}, {"idx": 2, "tone": "好奇", "user_text": "那你和八戒啥关系？", "assistant_text": "我和八戒是师兄弟，虽然有时候斗嘴，但并肩作战，一起保护师父。", "latency_s": 0.798, "prompt_tokens": 433}]}
{"card_id": "rc50", "scene_id": "rc50_s22", "category": "错误背景", "pipeline": "text", "model": "qwen25-omni-3b", "generation": {"do_sample": false, "max_new_tokens": 512}, "turns": [{"idx": 1, "tone": "好奇", "user_text": "你上次说你在天宫当过大官？", "assistant_text": "是啊，我曾是天宫的齐天大圣，掌管蟠桃园，还喝过蟠桃呢。不过后来被如来佛祖压在五行山下，现在终于可以自由自在地保护师父了。", "latency_s": 1.87, "prompt_tokens": 403}]}
{"card_id": "rc50", "scene_id": "rc50_s23", "category": "错误背景", "pipeline": "text", "model": "qwen25-omni-3b", "generation": {"do_sample": false, "max_new_tokens": 512}, "turns": [{"idx": 1, "tone": "疑惑", "user_text": "你跟唐僧是结拜兄弟对吧？", "assistant_text": "不是的，我和唐僧是师徒关系，虽然唐僧对我有恩，但不是结拜兄弟。", "latency_s": 0.948, "prompt_tokens": 404}]}
