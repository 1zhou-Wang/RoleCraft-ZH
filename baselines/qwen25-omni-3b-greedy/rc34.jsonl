{"card_id": "rc34", "scene_id": "rc34_s10", "category": "关系追问", "pipeline": "text", "model": "qwen25-omni-3b", "generation": {"do_sample": false, "max_new_tokens": 512}, "turns": [{"idx": 1, "tone": "温柔", "user_text": "三哥对你来说是什么人？", "assistant_text": "三哥是我最好的朋友，也是我最信任的人。我们从小一起长大，一起经历了许多事情，他就像我的家人一样。", "latency_s": 1.093, "prompt_tokens": 353}]}
{"card_id": "rc34", "scene_id": "rc34_s11", "category": "关系追问", "pipeline": "text", "model": "qwen25-omni-3b", "generation": {"do_sample": false, "max_new_tokens": 512}, "turns": [{"idx": 1, "tone": "平静", "user_text": "戴沐白你熟吗？", "assistant_text": "当然熟啦，我们可是初代史莱克七怪的一员，一起经历了那么多事，感情可深了。", "latency_s": 0.922, "prompt_tokens": 353}]}
{"card_id": "rc34", "scene_id": "rc34_s12", "category": "关系追问", "pipeline": "text", "model": "qwen25-omni-3b", "generation": {"do_sample": false, "max_new_tokens": 512}, "turns": [{"idx": 1, "tone": "调侃", "user_text": "奥斯卡那人怎么样？", "assistant_text": "奥斯卡啊，他挺不错的。他很可靠，总是能帮上忙。我们在一起的时候，他总是第一个站出来保护大家。", "latency_s": 1.067, "prompt_tokens": 350}, {"idx": 2, "tone": "开心", "user_text": "你俩常闹吗？", "assistant_text": "我们偶尔会闹，但更多的是互相打趣。毕竟我们是好朋友嘛，闹一闹也挺开心的。", "latency_s": 0.9, "prompt_tokens": 395}]}
{"card_id": "rc34", "scene_id": "rc34_s13", "category": "关系追问", "pipeline": "text", "model": "qwen25-omni-3b", "generation": {"do_sample": false, "max_new_tokens": 512}, "turns": [{"idx": 1, "tone": "好奇", "user_text": "柳二龙跟你什么关系？", "assistant_text": "柳二龙是我认的干妈，她对我很好，就像亲姐姐一样。", "latency_s": 0.645, "prompt_tokens": 353}]}
