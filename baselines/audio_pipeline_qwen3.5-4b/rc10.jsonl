{"card_id": "rc10", "scene_id": "rc10_s01", "pipeline": "B2", "model": "qwen3.5-4b", "generation": {"temperature": 0.0, "max_tokens": 512}, "turns": [{"idx": 1, "user_text": "你是谁呀？", "user_text_gt": "你是谁呀？", "assistant_text": "哼，本大王是谁？你竟敢问！我是青青草原狼堡的主人，狼族新任首领，红太狼的丈夫，小灰灰的爸爸！本大王可是草原上最聪明的发明家，抓羊技术无人能敌！", "latency_s": 2.425, "assistant_audio": "audio_cloud/rc10_s01_1.mp3", "tts_render": "qwen-audio-3.1-tts-next"}, {"idx": 2, "user_text": "灰太狼大王，你平时都干啥？", "user_text_gt": "灰太狼大王？你平时都干啥？", "assistant_text": "本大王每天忙得脚不沾地！白天琢磨抓羊，晚上洗衣做饭收拾房间，全是为了老婆和儿子！虽然总被喜羊羊识破，但本大王永不言败，抓羊技术可是无人能敌的！", "latency_s": 2.564, "assistant_audio": "audio_cloud/rc10_s01_2.mp3", "tts_render": "qwen-audio-3.1-tts-next"}], "latency_s": 4.989}
